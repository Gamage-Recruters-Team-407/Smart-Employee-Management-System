# ──────────────────────────────────
# API Configuration
# ──────────────────────────────────

# The base URL for your backend API.
# If you are using a proxy in your development server (e.g., in vite.config.js),
# you can use a relative path like "/api".
# Otherwise, specify the full URL to your backend server.
# Example for production: https://your-backend-domain.com
VITE_API_URL=http://localhost:5000

# ──────────────────────────────────
# Google Sign-In Configuration
# ──────────────────────────────────

# This is your Google Client ID, used for the "Sign in with Google" button
# on the frontend. It allows the frontend to securely communicate with Google.
# This value should be the same as the one used in the backend.
#
# How to get it:
# 1. Go to the Google Cloud Console.
# 2. Navigate to "APIs & Services" -> "Credentials".
# 3. Find your "OAuth 2.0 Client ID" for your web application.
#
# Make sure to add your frontend's address (e.g., http://localhost:5173)
# to the "Authorized JavaScript origins" in your Google Cloud settings.
VITE_GOOGLE_CLIENT_ID=""
