# ------------------------------------------------------------------------------
# APPLICATION CONFIGURATION
# ------------------------------------------------------------------------------
# Set to "development" or "production"
NODE_ENV=development

# The port the backend server will run on
PORT=5000

# The public URL of your frontend application (used for redirects)
FRONTEND_URL=http://localhost:5173

# ------------------------------------------------------------------------------
# DATABASE SETTINGS
# ------------------------------------------------------------------------------
# Your full MongoDB connection string
MONGO_URI="mongodb://localhost:27017/sems_database"

# ------------------------------------------------------------------------------
# AUTHENTICATION & SECURITY
# ------------------------------------------------------------------------------
# A long, random, and secure secret for signing JSON Web Tokens (JWT)
# Generate a secure key using an online generator or a command-line tool
JWT_SECRET="replace-with-a-very-secure-random-string"

# How long a JWT should be valid for (e.g., "7d", "24h", "60m")
JWT_EXPIRES_IN="7d"

# ------------------------------------------------------------------------------
# THIRD-PARTY API INTEGRATIONS (GOOGLE OAUTH)
# ------------------------------------------------------------------------------
# Your Google Client ID from the Google Cloud Console
GOOGLE_CLIENT_ID=""

# Your Google Client Secret from the Google Cloud Console
GOOGLE_CLIENT_SECRET=""

# The full URL that Google redirects to after authentication
# This MUST match one of the "Authorized redirect URIs" in your Google Cloud project
# Example for production: https://your-backend-domain.com/api/auth/google/callback
GOOGLE_CALLBACK_URL="http://localhost:5000/api/auth/google/callback"

# ------------------------------------------------------------------------------
# DEVELOPMENT-ONLY SETTINGS
# ------------------------------------------------------------------------------
# Set to "true" to bypass real Google login during development.
# This provides a mock login, so you don't need a client ID/secret.
# This is automatically disabled if NODE_ENV is "production".
GOOGLE_DEV_MOCK=true
