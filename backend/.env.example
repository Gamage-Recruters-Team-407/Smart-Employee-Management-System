PORT=5000
MONGO_URI=mongodb+srv://<username>:<password>@<cluster-host>/<database>?retryWrites=true&w=majority
MONGO_TRY_PRIMARY_IN_DEV=true
JWT_SECRET=your_jwt_secret_here

# Google OAuth (https://console.cloud.google.com/apis/credentials)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://127.0.0.1:5000/api/auth/google/callback
# When credentials are empty, dev uses mock Google sign-in (google.demo@sems.com). Set to false to disable.
GOOGLE_DEV_MOCK=true
FRONTEND_URL=http://127.0.0.1:5173
